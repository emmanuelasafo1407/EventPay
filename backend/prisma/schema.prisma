
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MORAPAY
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?  @unique
  role         UserRole @default(ATTENDEE)
  isActive     Boolean  @default(true)

  events       Event[]
  orders       Order[]
  checkIns     CheckIn[] @relation("CheckedInBy")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String      @id @default(cuid())
  organizerId String
  organizer   User        @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  title       String
  slug        String      @unique
  description String      @db.Text
  category    String
  imageUrl    String?

  venue       String
  city        String
  country     String      @default("Ghana")

  startsAt    DateTime
  endsAt      DateTime
  timezone    String      @default("Africa/Accra")

  status      EventStatus @default(DRAFT)
  publishedAt DateTime?

  ticketTypes TicketType[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([organizerId])
  @@index([status, startsAt])
}

model TicketType {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("GHS")

  quantityTotal Int
  quantitySold  Int      @default(0)

  salesStart   DateTime?
  salesEnd     DateTime?
  isActive     Boolean  @default(true)

  orderItems   OrderItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    String      @default("GHS")

  expiresAt   DateTime?
  paidAt      DateTime?

  items       OrderItem[]
  payments    Payment[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)

  tickets      Ticket[]

  createdAt    DateTime   @default(now())

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  provider          PaymentProvider @default(MORAPAY)
  status            PaymentStatus   @default(PENDING)

  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("GHS")

  providerReference String?         @unique
  checkoutUrl       String?
  failureReason     String?

  paidAt            DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

model Ticket {
  id          String       @id @default(cuid())
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  code        String       @unique
  qrToken     String       @unique
  status      TicketStatus @default(VALID)

  issuedAt    DateTime     @default(now())

  checkIn     CheckIn?
}

model CheckIn {
  id             String   @id @default(cuid())
  ticketId       String   @unique
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  checkedInById  String
  checkedInBy    User     @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)

  checkedInAt    DateTime @default(now())

  @@index([checkedInById])
}
